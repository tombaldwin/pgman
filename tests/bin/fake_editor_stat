#!/bin/sh
# fake_editor_stat — like fake_editor, but reports the octal
# permission mode of the file it's editing and of that file's parent
# directory, appended to the buffer content. Used to assert the
# `$EDITOR` scratch file/dir are owner-only *while the editor has
# them open* — checking from outside the subprocess would race the
# cleanup that runs right after this script exits.
set -e
for last; do :; done
file="$last"
dir=$(dirname "$file")
# GNU stat (Linux) uses `-c FORMAT`; BSD stat (macOS) uses `-f FORMAT`.
# On GNU, `-f` means "file-system status" and SUCCEEDS with the wrong
# output, so "try BSD, fall back to GNU" silently reported garbage on
# Linux. Detect GNU by `--version` instead.
if stat --version >/dev/null 2>&1; then
  file_mode=$(stat -c '%a' "$file")
  dir_mode=$(stat -c '%a' "$dir")
else
  file_mode=$(stat -f '%Lp' "$file")
  dir_mode=$(stat -f '%Lp' "$dir")
fi
content="$(cat "$file")"
{
  printf '%s' "$content"
  printf '\n-- file_mode=%s dir_mode=%s' "$file_mode" "$dir_mode"
} > "$file"
